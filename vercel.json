{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/health.ts": { "maxDuration": 20 }
  },
  "headers": [
    {
      "source": "/(icons/.*|og.png|brand-x-header.png)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
