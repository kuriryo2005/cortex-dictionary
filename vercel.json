{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/health.ts": { "maxDuration": 20 }
  },
  "headers": [
    {
      "source": "/(icons/.*|og.png|brand-x-header.png)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ig-webhook",
      "destination": "/api/billing-webhook?src=ig"
    },
    {
      "source": "/w",
      "destination": "/api/lookup?page=index"
    },
    {
      "source": "/w/",
      "destination": "/api/lookup?page=index"
    },
    {
      "source": "/w/:word",
      "destination": "/api/lookup?page=word&w=:word"
    }
  ]
}
