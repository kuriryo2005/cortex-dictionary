rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-|]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTags(data) {
      return !('tags' in data) || (data.tags is list && data.tags.size() <= 10);
    }

    function isValidSource(data) {
      return !('source' in data) ||
             (data.source is map && data.source.importedAt is number &&
              (!('title' in data.source) || (data.source.title is string && data.source.title.size() <= 100)) &&
              (!('excerpt' in data.source) || (data.source.excerpt is string && data.source.excerpt.size() <= 200)));
    }

    function isValidWord(data) {
      return data.word is string && data.word.size() > 0 && data.word.size() <= 500 &&
             data.meaning is string && data.meaning.size() > 0 && data.meaning.size() <= 1000 &&
             data.grammar is string && data.grammar.size() <= 100 &&
             data.userId == request.auth.uid &&
             data.timestamp is number &&
             (data.get('mode', '一般') in ['一般', '学術（Academic）']) &&
             (!('examples' in data) || (data.examples is list && data.examples.size() <= 10)) &&
             (!('specializedContexts' in data) || (data.specializedContexts is list && data.specializedContexts.size() <= 5)) &&
             (!('synonyms' in data) || (data.synonyms is list && data.synonyms.size() <= 10)) &&
             (!('reviewHistory' in data) || (data.reviewHistory is list && data.reviewHistory.size() <= 1000)) &&
             (!('nextReviewAt' in data) || (data.nextReviewAt is number)) &&
             // v2 追加フィールド（すべて optional。既存 v1 ドキュメントには無い）
             (!('phonetic' in data) || (data.phonetic is string && data.phonetic.size() <= 100)) &&
             (!('wordLower' in data) || (data.wordLower is string && data.wordLower.size() <= 500)) &&
             (!('schemaVersion' in data) || data.schemaVersion is number) &&
             (!('updatedAt' in data) || data.updatedAt is number) &&
             (!('deckId' in data) || data.deckId == null || (data.deckId is string && data.deckId.size() <= 128)) &&
             (!('enrichStatus' in data) || (data.enrichStatus in ['pending', 'done', 'error'])) &&
             // v3 追加：単語帳の紙面用。すべて optional
             (!('senses' in data) || (data.senses is list && data.senses.size() <= 8)) &&
             (!('targetPhrases' in data) || (data.targetPhrases is list && data.targetPhrases.size() <= 8)) &&
             (!('derivatives' in data) || (data.derivatives is list && data.derivatives.size() <= 8)) &&
             (!('examLevel' in data) || (data.examLevel is string && data.examLevel.size() <= 10)) &&
             // つながり図で生成した語源の解説（生成のたびの課金を避けるため保存する）
             (!('etymologyStory' in data) || (data.etymologyStory is string && data.etymologyStory.size() <= 2000)) &&
             isValidSource(data) &&
             isValidTags(data);
    }

    function isValidCache(data) {
      return data.word is string && data.word.size() > 0 && data.word.size() <= 500 &&
             data.meaning is string && data.meaning.size() > 0 && data.meaning.size() <= 1000 &&
             (!('specializedContexts' in data) || (data.specializedContexts is list && data.specializedContexts.size() <= 5));
    }

    // --- Collections ---

    match /words/{wordId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      isValidId(wordId) && 
                      isValidWord(incoming()) &&
                      incoming().keys().hasAll(['word', 'meaning', 'userId', 'timestamp']);
      
      allow update: if isSignedIn() && 
                      existing().userId == request.auth.uid &&
                      isValidWord(incoming()) &&
                      // Immutability check
                      incoming().userId == existing().userId &&
                      incoming().timestamp == existing().timestamp &&
                      // 旧実装は「内容の更新」と「復習の記録」で2つの hasOnly を
                      // OR で繋いでいたため、両方にまたがる更新（復習記録 +
                      // updatedAt など）がどちらのリストにも収まらず弾かれた。
                      // 単一の許可リストに統合する。
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        // v1
                        'word', 'meaning', 'grammar', 'category', 'etymology',
                        'nuance', 'specializedContexts', 'examples', 'synonyms',
                        'antonyms', 'etymologyNodes', 'mode', 'nextReviewAt',
                        'aiAnalysis', 'reviewHistory', 'collocations', 'importanceScore',
                        // v2
                        'schemaVersion', 'wordLower', 'updatedAt', 'tags', 'deckId', 'phonetic',
                        'enrichStatus', 'source',
                        // v3（単語帳の紙面用）
                        'senses', 'targetPhrases', 'derivatives', 'examLevel',
                        // つながり図
                        'etymologyStory'
                      ]);
      
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 単語をしまう入れ物（F7）。
    //
    // デッキを削除しても所属単語は消さない。アプリ側で deckId を null に
    // 戻してから削除する（削除で語彙が消えるのは事故のもと）。
    match /decks/{deckId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() && isValidId(deckId) &&
                      incoming().userId == request.auth.uid &&
                      incoming().name is string &&
                      // size() はバイト数。日本語は1文字最大3バイト程度なので、
                      // クライアント側の20文字上限（UTF-16コード単位）を確実に
                      // 通すため余裕を見て80バイトまで許可する。
                      incoming().name.size() > 0 && incoming().name.size() <= 80 &&
                      incoming().createdAt is number;

      allow update: if isSignedIn() && existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      incoming().name is string &&
                      // size() はバイト数。日本語は1文字最大3バイト程度なので、
                      // クライアント側の20文字上限（UTF-16コード単位）を確実に
                      // 通すため余裕を見て80バイトまで許可する。
                      incoming().name.size() > 0 && incoming().name.size() <= 80 &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'order', 'updatedAt']);

      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 連続学習日数など、単語一覧から計算できない値だけを置く（F6）。
    // 集計値はクライアント側のキャッシュから計算するのでここには持たない。
    match /user_stats/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid &&
                     incoming().userId == request.auth.uid &&
                     (!('streak' in incoming()) || incoming().streak is number) &&
                     (!('lastStudiedOn' in incoming()) ||
                      (incoming().lastStudiedOn is string && incoming().lastStudiedOn.size() <= 10));
    }

    // 検索のフェアユース上限カウンタ（日/週/月）。api/_lib/quota.ts が
    // 本人の ID トークンで読み書きする。他人のドキュメントは触れない。
    match /usage_counters/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid &&
                     incoming().userId == uid &&
                     incoming().dayKey is string && incoming().dayCount is number &&
                     incoming().weekKey is string && incoming().weekCount is number &&
                     incoming().monthKey is string && incoming().monthCount is number;
    }

    // Shared dictionary cache.
    //
    // NOTE: cacheKey must be ASCII to satisfy isValidId(). The client previously
    // built it as `${word}_${mode}` where mode contained Japanese characters
    // (e.g. "turbulence_一般"), so every create was rejected and the cache was
    // never populated. The client now emits `${wordLower}__${gen|aca}`.
    // ── 課金プラン ───────────────────────────────────────────────
    // 契約状態は Stripe Webhook（サーバー側のサービスアカウント）だけが
    // 書き込む。ユーザーは自分の契約を読めるだけで、書き換えは一切できない。
    // これを緩めると誰でも自分を Pro にできてしまうので絶対に変更しないこと。
    match /subscriptions/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /dictionary_cache/{cacheKey} {
      // Reading requires authentication. The app is login-only, and leaving this
      // open would give an unauthenticated path to AI-generated content.
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Entries may be created but never rewritten. Allowing updates would let
      // any signed-in user overwrite another user's cached entry with junk
      // (security_spec.md, attack #10: Cache Poisoning).
      //
      // A bad entry can be removed from the Firebase console; it will then be
      // regenerated on the next lookup.
      allow create: if isSignedIn() && isValidId(cacheKey) && isValidCache(incoming());
      allow update: if false;
      allow delete: if false;
    }
  }
}
